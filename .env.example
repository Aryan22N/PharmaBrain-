# Environment Variables Configuration
# Copy this file to .env before running docker-compose or services:
# cp .env.example .env

# 1. Google Gemini API Key (Required for AI structuring and summaries)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Database Connection String (Supabase PostgreSQL or local SQLite)
# For local SQLite: sqlite:////app/data/rx_local.db
# For Supabase: postgresql+psycopg2://postgres.xxxx:your_password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:////app/data/rx_local.db

# 3. API Security Tokens (Optional, defaults provided)
API_TOKEN=rx_local_dev_token_2026_secure
PYTHON_API_TOKEN=rx_local_dev_token_2026_secure

# 4. Frontend & Service Origins
FRONTEND_ORIGIN=http://localhost:3000
PYTHON_API_URL=http://python-ocr:8000
JWT_SECRET=your_jwt_secret_key_change_in_production
